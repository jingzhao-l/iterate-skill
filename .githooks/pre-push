#!/usr/bin/env bash
# Block a push to main whose lint would fail in CI, or whose commits carry an
# author identity this repo does not own.
#
# Install (git does not load this directory by itself):
#   cp .githooks/pre-push .git/hooks/pre-push
#
# Deliberate escape hatches, both visible in CI afterwards:
#   git push --no-verify
#   SKIP_PREPUSH=1 git push
set -euo pipefail

# The ref list is consumed more than once below, so buffer stdin up front.
refs=$(cat)

targets_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "${remote_ref:-}" in
    refs/heads/main | refs/heads/master) targets_main=1 ;;
  esac
done <<< "$refs"
if [ "$targets_main" = "0" ]; then
  exit 0
fi

if [ "${SKIP_PREPUSH:-0}" = "1" ]; then
  echo "pre-push: skipped via SKIP_PREPUSH=1 — CI will lint this push instead." >&2
  exit 0
fi

# --- author identity gate ---------------------------------------------------
# WHY THIS EXISTS. GitHub credits a commit to whatever account owns its AUTHOR
# email, and the repo's contributor list is built from that. On 2026-09-22 the
# v3.4.3 release commit was authored as "ethanlin <ethanlin@users.noreply.github.com>"
# — an identity auto-derived from this machine's account name, not a typo — and
# GitHub credited a stranger's pre-existing account with one contribution on main.
# It cannot be undone afterwards without rewriting every descendant commit, which
# would invalidate the tags, releases and npm provenance links built on them. The
# only cheap place to stop it is before the commit reaches the remote, which is here.
#
# Only these author emails may appear on commits being pushed to main. Add to the
# list when a new bot legitimately authors commits; do not widen it for a human.
# Comma-separated on one line: BSD awk (macOS) rejects a multi-line -v assignment.
ALLOWED_AUTHOR_EMAILS="ET_lin@outlook.com,41898282+github-actions[bot]@users.noreply.github.com,49699333+dependabot[bot]@users.noreply.github.com"
null_sha=0000000000000000000000000000000000000000
foreign=""
while read -r _local_ref local_sha remote_ref remote_sha; do
  case "${remote_ref:-}" in
    refs/heads/main | refs/heads/master) ;;
    *) continue ;;
  esac
  if [ "$remote_sha" = "$null_sha" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  # One git pass plus one awk pass for the whole range: scanning commit by commit
  # would spawn thousands of processes on a normal push and stall the pre-push gate.
  # No `|| true` here on purpose — if the scan cannot run, the push must fail closed
  # rather than let an unaudited author identity through.
  offenders=$(git log --format='%H %ae' "$range" 2>/dev/null | awk -v allowed="$ALLOWED_AUTHOR_EMAILS" '
    BEGIN { n = split(allowed, a, ","); for (i = 1; i <= n; i++) if (a[i] != "") ok[a[i]] = 1 }
    !($2 in ok) { print }
  ')
  [ -n "$offenders" ] || continue
  foreign+="$offenders"$'\n'
done <<< "$refs"

if [ -n "$foreign" ]; then
  cat >&2 <<'MESSAGE'

pre-push: blocked — a commit destined for main has an author identity this repo
          does not own. GitHub credits commits by author email, so pushing it
          would permanently add that account to the contributor list, and undoing
          that later means rewriting history and every tag/release/provenance on
          top of it. Offending commits (sha  author-email):
MESSAGE
  printf '%s\n' "$foreign" | sed '/^$/d;s/^/  /' >&2
  cat >&2 <<'MESSAGE'
  Fix:  re-author them, e.g.  git commit --amend --reset-author --no-edit
        or, if the identity is deliberate, extend ALLOWED_AUTHOR_EMAILS above.
MESSAGE
  exit 1
fi

cd "$(git rev-parse --show-toplevel)"
if [ ! -f ./scripts/check.sh ]; then
  # A checkout that predates this gate (e.g. a linked worktree still on an old
  # commit) must not be blocked by a missing file — say so and let it through.
  echo "pre-push: ./scripts/check.sh is absent here, so the lint gate could not run." >&2
  exit 0
fi
rc=0
./scripts/check.sh --lint-only || rc=$?
if [ "$rc" = 0 ]; then
  exit 0
fi
if [ "$rc" = 3 ]; then
  cat >&2 <<'MESSAGE'

pre-push: lint could not be verified here — this environment has no ruff
          matching CI's pinned version. check.sh above names the exact version
          and the install command.
  Anyway: git push --no-verify        (CI runs the same lint either way)
MESSAGE
  exit 1
fi
cat >&2 <<'MESSAGE'

pre-push: blocked. `ruff check` does not pass, so this push would turn main red.
  Fix:    ./scripts/check.sh --lint-only   (then `ruff check --fix` or edit)
  Later:  git push --no-verify             (CI still runs the same gate)
MESSAGE
exit 1
