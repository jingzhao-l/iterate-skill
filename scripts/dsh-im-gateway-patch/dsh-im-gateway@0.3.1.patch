+    async buildModelCard(channelId, chatId) {
+        const llm = this.ctx.llm;
+        if (!llm || typeof llm.listProviders !== 'function')
+            throw new Error('llm 服务不可用');
+        const pref = this.router.modelPrefOf(channelId, chatId) ?? { provider: this.config.provider, model: this.config.model };
+        const current = `${pref.provider}:${pref.model}`;
+        const providers = llm.listProviders() ?? [];
+        const elements = [];
+        for (const p of providers) {
+            let models = [];
+            try {
+                models = (await llm.listModels(p.id)) ?? [];
+            }
+            catch { models = []; }
+            if (models.length === 0) {
+                elements.push({ tag: 'markdown', content: `**${p.name}**（暂无可用模型）` });
+                continue;
+            }
+            for (const m of models) {
+                const key = `${p.id}:${m.id}`;
+                const isCurrent = key === current;
+                elements.push({
+                    tag: 'action',
+                    actions: [{
+                        tag: 'button',
+                        text: { tag: 'plain_text', content: isCurrent ? `✅ ${m.name}` : m.name },
+                        type: isCurrent ? 'primary' : 'default',
+                        value: { action: 'im_gateway_switch_model', provider: p.id, model: m.id },
+                    }],
+                });
+            }
+        }
+        return {
+            schema: '2.0',
+            header: { title: { tag: 'plain_text', content: '切换模型' }, template: 'blue' },
+            body: {
+                elements: [
+                    { tag: 'markdown', content: `当前模型：**${current}**
+点击下方按钮切换，下一条消息立即生效：` },
+                    ...elements,
+                ],
+            },
+        };
+    }
