+        const provider = String(value.provider ?? '');
+        const model = String(value.model ?? '');
+        if (!provider || !model)
+            return;
+        const chatId = action.chatId;
+        this.router.setModelPref(channel.id, chatId, provider, model);
+        this.logLine(`[${channel.id}] 卡片切换模型：${provider}:${model}（chat ${chatId}）`);
+        const text = `✅ 已切换模型：${provider}:${model}\n下一条消息生效。`;
+        if (action.messageId && typeof channel.updateCard === 'function') {
+            try {
+                await channel.updateCard(action.messageId, await this.buildModelCard(channel.id, chatId));
+                return;
+            }
+            catch { /* 刷新失败回退文本 */ }
         }
+        if (typeof channel.send === 'function')
+            await channel.send(chatId, text);
     }
